# SmartTA-fork environment configuration (MiniMax-M3 edition)
#
# Copy this file to `.env` and fill in your keys.
#
# Two providers are supported:
#   MINIMAX  -- primary text-generation path. Anthropic-Messages-compatible
#               endpoint at https://api.minimax.io/anthropic. If the
#               account runs out of balance, the client auto-falls-back
#               to GEMINI.
#   GEMINI   -- fallback. Also used for vision (the fork does not have
#               a working MiniMax vision path yet).
#
# At least ONE of {MINIMAX_API_KEY, GEMINI_API_KEY} must be set.

# ── Primary provider: MiniMax M3 (Anthropic-compatible) ─────────────
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_BASE=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT_S=90

# ── Fallback provider: Google Gemini (for 402/429/5xx + vision) ─────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Set FORCE_GEMINI=1 to bypass MiniMax entirely (use Gemini for everything).
# FORCE_GEMINI=0

# ── App settings ────────────────────────────────────────────────────
# DB_PATH=smart_teaching_assistant.db
# EXTRACTED_IMAGES_DIR=extracted_images
# TEMP_UPLOADS_DIR=temp_uploads
# EXPORTS_DIR=outputs
# USE_GPU=true
# MAX_RETRIES=3
# REQUEST_TIMEOUT=60

# ── PDF-Extract-Kit integration ────────────────────────────────────
# Path to the sibling PDF_extractor project that holds the
# DocLayout-YOLO model + pipeline/. If unset, the SmartTA fork falls
# back to its built-in YOLO loader that walks up the directory tree
# looking for the parent project.
#
# Example for this machine:
#   PDF_EXTRACTOR_PARENT_DIR=E:/Projects/PDF_extractor
#
# PDF_EXTRACTOR_PARENT_DIR=
